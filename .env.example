# Copy to .env.local for local dev. Set the same variables in Vercel (Project > Settings > Environment Variables).

# Used for canonical URLs, sitemap, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Free access key from https://web3forms.com (enter your email, they send you the key).
# It is public by design; messages are delivered to the email you registered.
NEXT_PUBLIC_WEB3FORMS_KEY=612f2bdf-c535-49d0-94e0-0e9780d2f3dd
